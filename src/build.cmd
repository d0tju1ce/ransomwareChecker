@echo off
rem Builds RansomwareChecker.exe with the C# compiler included in .NET Framework 4.x (part of Windows, nothing to install).
rem The exe is a portable front-end for RansomwareChecker.ps1 (must stay next to the exe together with config\).
rem The icon (app.ico) is generated by make_icon.ps1. The font Oswald (fonts\Oswald-Regular.ttf + Oswald-SemiBold.ttf, SIL OFL) is embedded.
setlocal
set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
cd /d "%~dp0"
if not exist app.ico powershell -NoProfile -ExecutionPolicy Bypass -File make_icon.ps1
"%CSC%" /nologo /target:winexe /platform:anycpu /optimize+ /codepage:65001 /win32manifest:app.manifest ^
  /reference:System.Windows.Forms.dll /reference:System.Drawing.dll /reference:System.Web.Extensions.dll ^
  /resource:fonts\Oswald-Regular.ttf,Oswald-Regular.ttf /resource:fonts\Oswald-SemiBold.ttf,Oswald-SemiBold.ttf ^
  /win32icon:app.ico /resource:app.ico,App.ico /out:..\RansomwareChecker.exe RansomwareCheckerApp.cs
if errorlevel 1 (echo Build FAILED & exit /b 1)
echo Build OK: RansomwareChecker.exe
powershell -NoProfile -ExecutionPolicy Bypass -File sign.ps1
